{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User account information and app preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "user_data": {
      "title": "User App Data",
      "description": "Bookmarks, notes, and dhikr counts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bookmarks": { "type": "array", "items": { "type": "object" } },
        "notes": { "type": "array", "items": { "type": "object" } },
        "dhikrCounts": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "system_announcements": {
      "title": "System Announcements",
      "description": "Broadcast announcements and alerts published by app owner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "active": { "type": "boolean" },
        "allowDismiss": { "type": "boolean" },
        "actionUrl": { "type": "string" },
        "actionText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "title", "active"]
    },
    "system_config": {
      "title": "System Configuration",
      "description": "System version control, maintenance mode and feature toggles",
      "type": "object",
      "properties": {
        "latestVersion": { "type": "string" },
        "apkDownloadUrl": { "type": "string" },
        "forceUpdate": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "message": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
