rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDataOwner() {
      return isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid)
      );
    }

    // Default Deny Catch-All Security Gate
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents (users/{userId})
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) 
        && (request.resource.data.uid == userId || request.resource.data.userId == userId);
      allow delete: if isOwner(userId);
    }
    
    // User specific application data (user_data/{docId})
    match /user_data/{docId} {
      allow read, write: if isDataOwner();
    }
  }
}
